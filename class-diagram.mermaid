classDiagram

class Program {
    +void main()$
}

class GraphicsService {
    
}

class ElectoralService {

}

class InputService <<interface>> {

}

class DesktopInputService {
    %%Raspberry Pi
}

class EmbeddedInputService {

}

class CandidateRepository {
    +String getPartyByNumber(String number)
    +String getCandidateByNumber(String number)
}

class CandidateEntity {
    %% TODO ver com nirton o encapsulamento das
    %% entidades do DB no java
    +id: int
    +partyId: int
    +kind: RoleKind
    +name: String
    +image: String
    +viceName: String
    +viceImage: String
}

class ElectoralPartyEntity {
    %% TODO ver com nirton o encapsulamento das
    %% entidades do DB no java
    +id: int
    +name: String
}

class VoteEntry {
    %% TODO ver com nirton o encapsulamento das
    %% entidades do DB no java
    +id: int
    +electorId: String
    +candidateId: int
}

class CandidateVotes {
    +candidateId: int
    +candidateName: s
}

class BallotBox {
    %% municipality -> 5 digits
    %% UE -> 8 digits

    -voteEntries: List<VoteEntry>
    -municipality: String
    -municipalityCode: int 
    -openingDateTime: LocalDateTime
    -closingDateTime: LocalDateTime
    -electoralZone: int
    -section: int
    -eligibleVoters: int
    
    +String getMunicipality()
    +int getMunicipalityCode()
    +int getZoneelectoral()
    +int getSection()

    +void begin()
    +void end()

    +int getTotalVotes()
    +boolean alreadyVoted(String electorId)

    +void emmitBulletin()
}

class PollWorkerTerminal {
    
}

class VoterTerminal {
    
}

class IndicatorLed {
    -led: LedColor
    -blinking: bool
}

class RoleKind <<enumeration>> {
    Mayor
    CityCouncilour
}

class LedColor <<enumeration>> {
    Off
    Green
    Yellow
}


Program *-- PollWorkerTerminal : Singleton
Program *-- VoterTerminal : Singleton
Program *-- GraphicsService : Singleton
Program *-- ElectoralService : Singleton
Program *-- InputService : Singleton

ElectoralService o-- CandidateRepository
ElectoralService o-- BallotBox

InputService <|.. DesktopInputService
InputService <|.. EmbeddedInputService

BallotBox "1" *-- "*" VoteEntry : Listado por
CandidateRepository ..> CandidateEntity : Retorna
CandidateRepository ..> ElectoralPartyEntity : Retorna
VoterTerminal ..> CandidateEntity : Consome
VoterTerminal ..> ElectoralPartyEntity : Consome
VoterTerminal ..> CandidateRepository : Requisita Serviços
VoterTerminal ..> BallotBox : Requisita Serviços

CandidateEntity ..> RoleKind : Usa
IndicatorLed ..> LedColor : Usa
